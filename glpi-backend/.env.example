# Copiar pra .env no servidor (não commitar o .env de verdade).
PORT=4001
DB_HOST=192.0.2.10
DB_PORT=3306
DB_USER=chatglpi_svc
DB_PASSWORD=CHANGE_ME_use_a_strong_password
DB_NAME=glpi
# Mesmo valor de PLUGIN_CHATGLPI_SHARED_SECRET em setup.php do plugin GLPI.
CHATGLPI_SHARED_SECRET=CHANGE_ME_generate_64_hex_chars_openssl_rand_hex_32
# Origens da página do GLPI que podem chamar esta API (CORS) - lista
# separada por vírgula. O GLPI é acessado por IP e por hostname, então as
# duas precisam estar aqui.
ALLOWED_ORIGIN=http://192.0.2.10,http://glpi.example.com
